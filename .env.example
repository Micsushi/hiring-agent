# Default model to use (must exist in providers.json).
# Ollama examples: "gemma3:4b", "qwen3:4b", "mistral:7b"
# Gemini examples: "gemini-2.5-pro", "gemini-2.5-flash"
# OpenRouter examples:
#   "qwen/qwen3.7-max"              # latest flagship Qwen listed on OpenRouter
#   "qwen/qwen3.7-plus"             # cheaper Qwen option
#   "deepseek/deepseek-v4-flash"    # cheaper/faster DeepSeek option
#   "deepseek/deepseek-v4-pro"      # stronger DeepSeek option
DEFAULT_MODEL=qwen/qwen3.7-max

# API keys — only needed for providers whose api_key_env is set in providers.json.
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (required if using OpenRouter provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
